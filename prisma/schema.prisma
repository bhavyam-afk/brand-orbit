generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////

enum UserRole {
  INFLUENCER
  BRAND
}

enum MediaType {
  STORY
  REEL
  POST
  LIVE
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

//////////////////////////////////////////////////
// MODELS
//////////////////////////////////////////////////

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  role          UserRole 
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  influencerProfile InfluencerProfile?
  brandProfile       BrandProfile?
}

//////////////////////////////////////////////////
// INFLUENCER
//////////////////////////////////////////////////

model InfluencerProfile {
  id             String      @id @default(cuid())
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String      @unique
  username       String      @unique
  bio            String?
  niche          String?
  followersCount Int?
  platformLinks  Json?       // store social links like { instagram: "...", youtube: "..." }
  profilePic     String?
  location       String?
  rating         Float?      @default(0)

  // Relations
  packages       Package[]
  offers         Offer[]     @relation("InfluencerOffers")
  payments       Payment[]   @relation("InfluencerPayments")

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

//////////////////////////////////////////////////
// BRAND
//////////////////////////////////////////////////

model BrandProfile {
  id             String      @id @default(cuid())
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String      @unique
  brandName      String
  industry       String?
  logoUrl        String?
  location       String?
  contactPerson  String?

  // Relations
  offers         Offer[]     @relation("BrandOffers")
  payments       Payment[]   @relation("BrandPayments")

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

//////////////////////////////////////////////////
// PACKAGE
//////////////////////////////////////////////////

model Package {
  id             String       @id @default(cuid())
  influencer     InfluencerProfile @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  influencerId   String
  title          String
  description    String?
  price          Float
  deliveryTime   Int?          // in days
  platform       String?       // e.g., "Instagram"
  mediaType      MediaType
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  offers         Offer[]
}

//////////////////////////////////////////////////
// OFFER
//////////////////////////////////////////////////

model Offer {
  id              String       @id @default(cuid())
  brand           BrandProfile       @relation("BrandOffers", fields: [brandId], references: [id], onDelete: Cascade)
  brandId         String
  influencer      InfluencerProfile  @relation("InfluencerOffers", fields: [influencerId], references: [id], onDelete: Cascade)
  influencerId    String
  package         Package?           @relation(fields: [packageId], references: [id])
  packageId       String?
  offerAmount     Float
  message         String?
  status          OfferStatus        @default(PENDING)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  // Relations
  payment         Payment?
  chatMessages    ChatMessage[]
}

//////////////////////////////////////////////////
// PAYMENT
//////////////////////////////////////////////////

model Payment {
  id              String       @id @default(cuid())
  offer           Offer        @relation(fields: [offerId], references: [id], onDelete: Cascade)
  offerId         String   @unique
  brand           BrandProfile       @relation("BrandPayments", fields: [brandId], references: [id], onDelete: Cascade)
  brandId         String
  influencer      InfluencerProfile  @relation("InfluencerPayments", fields: [influencerId], references: [id], onDelete: Cascade)
  influencerId    String
  amount          Float
  platformFee     Float?        @default(0)
  status          PaymentStatus @default(PENDING)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

//////////////////////////////////////////////////
// CHAT (optional but useful)
//////////////////////////////////////////////////

model ChatMessage {
  id              String     @id @default(cuid())
  offer           Offer      @relation(fields: [offerId], references: [id], onDelete: Cascade)
  offerId         String
  senderId        String     // User id
  receiverId      String     // User id
  message         String
  sentAt          DateTime   @default(now())
}


