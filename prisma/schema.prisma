// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// --- ENUMS ---

enum UserType {
  CREATOR
  BRAND
}

enum PackageStatus {
  ACTIVE
  DRAFT
  DELETED
}

enum CollabStatus {
  PENDING // Brand has requested, creator hasn't accepted yet 
  ACTIVE // In progress
  COMPLETED // Finished, awaiting payment/review 
  CANCELLED
}

enum TransactionType {
  DEPOSIT // Brand adds funds
  WITHDRAWAL // Creator takes funds out
  PAYMENT // Brand pays for a collab (escrow)
  PAYOUT // Creator receives collab funds
  FEE // Your platform fee
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum CreatorCategory {
  NANO
  MICRO
  MACRO
  CELEB
}

enum AvailabilityStatus {
  AVAILABLE
  UNAVAILABLE
  TENTATIVE
}

enum CampaignStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}
 
enum contentStatus {
  NOT_SUBMITTED
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum CollabType {
  PACKAGE
  CAMPAIGN
}

enum WalletType {
  CREATOR
  BRAND
}


// --- CORE MODELS ---

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  passwordHash String
  userType     UserType
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  creatorProfile CreatorProfile?
  brandProfile   BrandProfile?
  wallet         Wallet?
}

// --- CREATOR SIDE MODELS ---

model CreatorProfile {
  id             String          @id @default(cuid())
  user           User            @relation(fields: [userId], references: [id])
  userId         String          @unique // 1-to-1 relation with User
  bio            String?         @db.Text
  username       String          @unique
  location       String?
  niche          String?
  profilePicUrl  String?
  introClipUrl   String? // For the 20sec intro clip
  nicheTags      String[]
  portfolio      Json? // Store as [{ "title": "...", "url": "..." }]
  mlScore        Float? // Your internal ML score
  category       CreatorCategory
  platformLinks  Json? // Store as [{ "platform": "instagram", "url": "..." }]
  follower_count Int             @default(0)
  walletId       String?         @unique
  wallet         Wallet?         @relation(fields: [walletId], references: [id]) // 1-to-1 relation with Wallet

  // Relations 
  packages           Package[]
  collaborations     Collaboration[]
  followerSnapshots  CreatorFollowerSnapshot[]
  availabilities     CreatorAvailability[]
  dailyMetrics       CreatorDailyMetrics[]
  socialAccounts     CreatorSocialAccount[]
  rawSocialSnapshots CreatorSocialRawSnapshot[]

  @@unique([id, username])
  @@index([userId])
}

// --- BRAND SIDE MODELS ---

model BrandProfile {
  id           String   @id @default(cuid())
  user         User     @relation(fields: [userId], references: [id])
  userId       String   @unique
  username     String   @unique
  logoUrl      String?
  bio          String?  @db.Text
  industryTags String[]
  socialLinks  Json? // Store as [{ "platform": "website", "url": "..." }]
  walletId     String?  @unique
  wallet       Wallet?  @relation(fields: [walletId], references: [id]) // 1-to-1 relation with Wallet

  // Relations
  campaigns      Campaign[]
  collaborations Collaboration[]

  @@unique([id, username])
  @@index([userId])
}

model Package {
  id               String         @id @default(cuid())
  creator          CreatorProfile @relation(fields: [creatorId], references: [id])
  creatorId        String
  title            String
  description      String?        @db.Text
  thumbnailUrl     String?
  mediaType        String // e.g., "Instagram Post", "TikTok Video"
  deliverables     String[] // e.g., ["1 Post", "1 Story"]
  deliveryTimeDays Int
  price            Decimal        @db.Decimal(10, 2) // Price for the package 
  packagestatus    PackageStatus  @default(DRAFT) // for visibility 

  // Relations
  packageCollaborations PackageCollaboration[]
  collaborations        Collaboration[]
  @@index([creatorId])
}

model Campaign {
  id             String         @id @default(cuid())
  brand          BrandProfile   @relation(fields: [brandId], references: [id])
  brandId        String
  name           String
  budget         Decimal?       @db.Decimal(12, 2)
  startDate      DateTime?
  endDate        DateTime?
  creators       String[]
  campaignstatus CampaignStatus @default(ACTIVE)

  // Relations
  collaborations         Collaboration[]
  reports                Report[]
  campaignCollaborations CampaignCollaboration[]

  @@index([brandId])
}

// --- SHARED MODELS (The Core of your App) ---

model Collaboration {
  id           String       @id @default(cuid())
  creatorId    String
  brandId      String
  packageId    String
  campaignId   String?
  collabType   CollabType
  collabstatus CollabStatus @default(PENDING)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  // Relations
  creator                CreatorProfile          @relation(fields: [creatorId], references: [id])
  brand                  BrandProfile            @relation(fields: [brandId], references: [id])
  campaign               Campaign?               @relation(fields: [campaignId], references: [id])
  package                Package?                @relation(fields: [packageId], references: [id])
  reports                Report[]
  packageCollaborations  PackageCollaboration[]
  campaignCollaborations CampaignCollaboration[]

  @@index([creatorId])
  @@index([brandId])
  @@index([packageId])
  @@index([campaignId])
}

model PackageCollaboration {
  id                  String        @id @default(cuid())
  collabId            String        @unique
  packageId           String
  contentStatus       contentStatus @default(NOT_SUBMITTED)
  contentDraft        Json? // URL to draft content (S3/GCS) 
  draftSubmittedAt    DateTime?
  brandFeedback       String? // Feedback from brand on draft
  draftapprovalAt     DateTime?
  publishedContentUrl String? // URL to published content
  publishedAt         DateTime?

  collaboration Collaboration @relation(fields: [collabId], references: [id])
  package       Package       @relation(fields: [packageId], references: [id])
}

model CampaignCollaboration {
  id                  String        @id @default(cuid())
  collabId            String        @unique
  campaignId          String
  scope               Json
  contentStatus       contentStatus @default(NOT_SUBMITTED)
  contentDraft        Json? // URL to draft content (S3/GCS)
  draftSubmittedAt    DateTime?
  brandFeedback       String? // Feedback from brand on draft
  draftapprovalAt     DateTime?
  publishedContentUrl String? // URL to published content
  publishedAt         DateTime?

  collaboration Collaboration @relation(fields: [collabId], references: [id])
  campaign      Campaign      @relation(fields: [campaignId], references: [id])

  @@index([campaignId])
}

model Report {
  id          String   @id @default(cuid())
  pdfUrl      String // URL to the generated PDF stored in S3/GCS
  generatedAt DateTime @default(now())

  campaign   Campaign? @relation(fields: [campaignId], references: [id])
  campaignId String? // Link to a whole campaign

  collaboration Collaboration? @relation(fields: [collabId], references: [id])
  collabId      String? // Link to a single collab

  @@index([campaignId])
  @@index([collabId])
}

// --- FINANCIAL MODELS (Critical!) ---

model Wallet {
  id         String     @id @default(cuid())
  userId     String     @unique
  walletType WalletType

  // balances
  currentBalance Decimal @default(0) @db.Decimal(12, 2)
  pendingBalance Decimal @default(0) @db.Decimal(12, 2)

  // aggregates
  totalEarned Decimal @default(0) @db.Decimal(12, 2)
  totalSpent  Decimal @default(0) @db.Decimal(12, 2)

  // ledger relations
  user                 User            @relation(fields: [userId], references: [id])
  outgoingTransactions Transaction[]   @relation("FromWallet")
  incomingTransactions Transaction[]   @relation("ToWallet")
  creatorProfile       CreatorProfile?
  brandProfile         BrandProfile?

  @@index([userId])
}

model Transaction {
  id               String            @id @default(cuid())
  // money flow
  fromWalletId     String
  toWalletId       String
  amount           Decimal           @db.Decimal(12, 2)
  type             TransactionType
  status           TransactionStatus @default(PENDING)
  collabId         String? 
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  fromWallet     Wallet          @relation("FromWallet", fields: [fromWalletId], references: [id])
  toWallet       Wallet          @relation("ToWallet", fields: [toWalletId], references: [id])

  @@index([fromWalletId])
  @@index([toWalletId])
  @@index([collabId])
}

model CreatorFollowerSnapshot {
  id                  String   @id @default(cuid())
  creatorId           String
  followers_increased Int
  recordedAt          DateTime @default(now())

  creator CreatorProfile @relation(fields: [creatorId], references: [id])

  @@index([creatorId, recordedAt])
}

model CreatorAvailability {
  id        String         @id @default(cuid())
  creator   CreatorProfile @relation(fields: [creatorId], references: [id])
  creatorId String

  date   DateTime
  status AvailabilityStatus

  reason    String? // optional note like "Campaign", "Vacation"
  createdAt DateTime @default(now())

  @@unique([creatorId, date])
  @@index([creatorId, date])
}

model CreatorSocialRawSnapshot {
  id        String   @id @default(cuid())
  creatorId String
  platform  String // INSTAGRAM, YOUTUBE, etc
  rawData   Json // Full Meta API response
  fetchedAt DateTime @default(now())

  creator CreatorProfile @relation(fields: [creatorId], references: [id])

  @@index([creatorId, fetchedAt])
}

model CreatorDailyMetrics {
  id        String   @id @default(cuid())
  creatorId String
  date      DateTime

  followers   Int
  reach       Int?
  impressions Int?
  engagement  Int?

  creator CreatorProfile @relation(fields: [creatorId], references: [id])

  @@unique([creatorId, date])
  @@index([creatorId, date])
}

model CreatorSocialAccount {
  id             String    @id @default(cuid())
  creatorId      String
  platform       String // INSTAGRAM
  accessToken    String
  tokenExpiresAt DateTime?
  igAccountId    String?
  pageId         String?
  connected      Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  creator CreatorProfile @relation(fields: [creatorId], references: [id])

  @@unique([creatorId, platform])
}
