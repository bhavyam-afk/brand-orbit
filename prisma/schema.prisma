generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  passwordHash      String
  role              UserRole
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  brandProfile      BrandProfile?
  influencerProfile InfluencerProfile?
}

model InfluencerProfile {
  id             String    @id @default(cuid())
  userId         String    @unique
  username       String    @unique
  bio            String?
  niche          String?
  followersCount Int?
  platformLinks  Json?
  profilePic     String?
  location       String?
  rating         Float?    @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  offers         Offer[]   @relation("InfluencerOffers")
  packages       Package[]
  payments       Payment[] @relation("InfluencerPayments")
}

model BrandProfile {
  id            String    @id @default(cuid())
  userId        String    @unique
  brandName     String
  industry      String?
  logoUrl       String?
  location      String?
  contactPerson String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  offers        Offer[]   @relation("BrandOffers")
  payments      Payment[] @relation("BrandPayments")
}

model Package {
  id           String            @id @default(cuid())
  influencerId String
  title        String
  description  String?
  price        Float
  deliveryTime Int?
  platform     String?
  mediaType    MediaType
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  offers       Offer[]
  influencer   InfluencerProfile @relation(fields: [influencerId], references: [id], onDelete: Cascade)
}

model Offer {
  id           String            @id @default(cuid())
  brandId      String
  influencerId String
  packageId    String?
  offerAmount  Float
  message      String?
  status       OfferStatus       @default(PENDING)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  chatMessages ChatMessage[]
  brand        BrandProfile      @relation("BrandOffers", fields: [brandId], references: [id], onDelete: Cascade)
  influencer   InfluencerProfile @relation("InfluencerOffers", fields: [influencerId], references: [id], onDelete: Cascade)
  package      Package?          @relation(fields: [packageId], references: [id])
  payment      Payment?
}

model Payment {
  id           String            @id @default(cuid())
  amount       Float
  brandId      String
  influencerId String
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  offerId      String            @unique
  platformFee  Float?            @default(0)
  status       PaymentStatus     @default(PENDING)
  brand        BrandProfile      @relation("BrandPayments", fields: [brandId], references: [id], onDelete: Cascade)
  influencer   InfluencerProfile @relation("InfluencerPayments", fields: [influencerId], references: [id], onDelete: Cascade)
  offer        Offer             @relation(fields: [offerId], references: [id], onDelete: Cascade)
}

model ChatMessage {
  id         String   @id @default(cuid())
  offerId    String
  senderId   String
  receiverId String
  message    String
  sentAt     DateTime @default(now())
  offer      Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
}

enum UserRole {
  INFLUENCER
  BRAND
}

enum MediaType {
  STORY
  REEL
  POST
  LIVE
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}
